<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1628">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 LAN ИГРА"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:layout_marginBottom="10dp" />

        <!-- Два блока: ХОСТ слева, КЛИЕНТ справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">

            <!-- === Блок ХОСТА === -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/panel_blue"
                android:padding="12dp"
                android:layout_marginEnd="8dp">

                <Button
                    android:id="@+id/btnCreateGame"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🖥  СОЗДАТЬ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#3A2A00"
                    android:background="@drawable/btn_yellow"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp" />

                <TextView
                    android:id="@+id/tvHostId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: —"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvHostStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#B0E0B0"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- === Блок КЛИЕНТА === -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/panel_blue"
                android:padding="12dp"
                android:layout_marginStart="8dp">

                <EditText
                    android:id="@+id/etHostIp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="192.168.1.42:8888"
                    android:textColorHint="#7080A0"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@drawable/panel_blue"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📱  ПОДКЛЮЧИТЬСЯ"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_blue"
                    android:stateListAnimator="@null"
                    android:elevation="0dp"
                    android:padding="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Кнопка НАЧАТЬ ИГРУ (появляется после подключения) -->
        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="300dp"
            android:layout_height="52dp"
            android:text="▶  НАЧАТЬ ИГРУ"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3A2A00"
            android:background="@drawable/btn_yellow"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Кнопка Назад -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="200dp"
            android:layout_height="46dp"
            android:text="⬅  НАЗАД"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_red"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

    </LinearLayout>

</FrameLayout>
