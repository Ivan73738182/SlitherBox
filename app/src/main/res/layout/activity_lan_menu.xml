<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1628">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 LAN ИГРА"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:layout_marginBottom="20dp" />

        <!-- Блок ХОСТА -->
        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/panel_blue"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnCreateGame"
                android:layout_width="300dp"
                android:layout_height="60dp"
                android:text="🖥  СОЗДАТЬ ИГРУ"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#3A2A00"
                android:background="@drawable/btn_yellow"
                android:stateListAnimator="@null"
                android:elevation="0dp" />

            <TextView
                android:id="@+id/tvHostId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID: —"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvHostStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#B0E0B0"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Блок КЛИЕНТА -->
        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/panel_blue"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Подключиться к другу"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etHostIp"
                android:layout_width="300dp"
                android:layout_height="50dp"
                android:hint="Например: 192.168.1.42:8888"
                android:textColorHint="#7080A0"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="@drawable/panel_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="300dp"
                android:layout_height="60dp"
                android:text="📱  ПОДКЛЮЧИТЬСЯ"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_blue"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>

        <!-- Кнопка Назад -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="⬅  НАЗАД"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_red"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

    </LinearLayout>

</FrameLayout>
