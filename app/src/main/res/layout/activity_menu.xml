<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Фон рисуется в MenuView -->
    <com.ivangames.slitherbox.MenuView
        android:id="@+id/menuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Контент поверх -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <!-- Название -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SlitherBox"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="6"
            android:layout_marginBottom="10dp" />

        <!-- Кнопка ИГРАТЬ (большая, жёлтая) -->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="300dp"
            android:layout_height="56dp"
            android:text="▶  ИГРАТЬ"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3A2A00"
            android:background="@drawable/btn_yellow"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginBottom="8dp" />

        <!-- Кнопка РЕКОРДЫ -->
        <Button
            android:id="@+id/btnRecords"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:text="🏆  РЕКОРДЫ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_blue"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginBottom="6dp" />

        <!-- Кнопка LAN -->
        <Button
            android:id="@+id/btnLan"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:text="🌐  LAN ИГРА"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_blue"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginBottom="6dp" />

        <!-- Кнопка ВЫХОД -->
        <Button
            android:id="@+id/btnExit"
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:text="🚪  ВЫХОД"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_red"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

    </LinearLayout>

</FrameLayout>
