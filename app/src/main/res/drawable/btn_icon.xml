<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A2A3A" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#5A7A9A"
                android:endColor="#2A4055" />
            <stroke android:width="2dp" android:color="#8AA8C8" />
        </shape>
    </item>
</layer-list>
