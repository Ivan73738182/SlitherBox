<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Тень снизу -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7A5A00" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Сама кнопка -->
    <item android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFE050"
                android:centerColor="#FFC107"
                android:endColor="#E5A500"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#FFF080" />
        </shape>
    </item>

</layer-list>
