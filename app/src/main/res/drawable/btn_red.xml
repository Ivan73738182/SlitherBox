<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5A1010" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E55555"
                android:centerColor="#C03030"
                android:endColor="#8A1A1A"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#FF8080" />
        </shape>
    </item>

</layer-list>
